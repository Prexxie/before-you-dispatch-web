# Base URL of before-you-dispatch-api (no trailing slash). Server-side only:
# the app forwards browser calls to /api/* here (see next.config.ts).
API_URL=http://localhost:4000
# Google sign-in: the OAuth Client ID from Google Cloud (ends in
# .apps.googleusercontent.com), the same value as the API's GOOGLE_CLIENT_ID.
# Leave empty to hide the Google buttons.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
